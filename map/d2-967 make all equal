#include<bits/stdc++.h>
using namespace std;

void solve()
{
    int n;
    cin >> n;

    vector<int> a(n);
    for (int i = 0; i < n; i++)
    {
        cin >> a[i];
    }
    sort(a.begin(), a.end());

    map<int, int> mp;
    int max_element = 0;
    for (auto m : a)
    {
        mp[m]++;
        max_element = max(max_element, mp[m]);
    }

    cout << n - max_element << "\n";
}

int main(){
    int t;
    cin>>t;
    
    while(t--){
        solve();
    }
}

